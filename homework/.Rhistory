library(janitor)
md_cities <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_cities_crime_2019_2020.csv")
View(md_cities)
md_cities <- md_cities |> mutate(violent_rate_2019 = violent2019/pop2019)
md_cities <- md_cities |> mutate(property_rate_2019 = property2019/pop2019)
md_cities <- md_cities |> mutate(violent_rate_2020 = violent2020/pop2020)
md_cities <- md_cities |> mutate(property_rate_2020 = property2020/pop2020)
md_cities <- md_cities |> mutate(violent_rate_2019 = violent2019/pop2019 *100000)
md_cities <- md_cities |> mutate(property_rate_2019 = property2019/pop2019*100000)
md_cities <- md_cities |> mutate(violent_rate_2020 = violent2020/pop2020*100000)
md_cities <- md_cities |> mutate(property_rate_2020 = property2020/pop2020*100000)
md_cities_change <- md_cities |> mutate(violent_change = (violent_rate_2020-violent_rate_2019)/violent_rate_2019)
md_cities_change <- md_cities |> mutate(property_change = (property_rate_2020-property_rate_2019)/property_rate_2019)
View(md_cities_change)

knitr::opts_chunk$set(echo = TRUE)
ggplot(billboard_100, aes(x = Danceability)) +
geom_histogram(bins = 30, fill = "skyblue", color = "white") +
theme_minimal() +
labs(
title = "Distribution of Danceability",
x = "Danceability",
y = "Count"
)

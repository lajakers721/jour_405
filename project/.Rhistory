knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
billboard_100 <- read.csv("billboard.csv")
View(billboard_100)
billboard_100 |> mean(Danceability)
billboard_100 |> median(Danceability)
billboard_100 |> summarize(median_danceability = median(Danceability), mean_danceability = mean(Danceability))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=FALSE))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=FALSE))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=TRUE))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=TRUE)), mutate(min_danceability = min(Danceability, na.rm=TRUE), max_danceability = max(Danceability, na.rm=TRUE))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=TRUE)) + mutate(min_danceability = min(Danceability, na.rm=TRUE), max_danceability = max(Danceability, na.rm=TRUE))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=TRUE))
billboard_100 |> mutate(min_danceability = min(Danceability, na.rm=TRUE), max_danceability = max(Danceability, na.rm=TRUE))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=TRUE))
billboard_100 |> summarize(min_danceability = min(Danceability, na.rm=TRUE), max_danceability = max(Danceability, na.rm=TRUE))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=TRUE), min_danceability = min(Danceability, na.rm=TRUE), max_danceability = max(Danceability, na.rm=TRUE))
billboard_100 |> summarize(median_danceability = median(Danceability, na.rm=TRUE), mean_danceability = mean(Danceability, na.rm=TRUE), min_danceability = min(Danceability, na.rm=TRUE), max_danceability = max(Danceability, na.rm=TRUE))
